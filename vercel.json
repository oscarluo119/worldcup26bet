{
  "routes": [
    {
      "src": "/api/cron/sync-live-scores",
      "dest": "/api/cron/sync-live-scores.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-live-scores",
      "schedule": "* * * * *"
    }
  ]
}
